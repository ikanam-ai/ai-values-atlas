{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-values-atlas.org/schema/instrument.schema.json",
  "title": "Value elicitation or measurement instrument",
  "type": "object",
  "required": ["id", "name", "aliases", "instrument_type", "axiology_ids", "primary_url", "status"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "name": {"type": "string"},
    "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "instrument_type": {
      "enum": [
        "self_report_questionnaire", "survey_item_bank", "scenario_item_bank",
        "independent_endorsement_protocol", "forced_choice_protocol",
        "ranking_protocol", "free_text_protocol", "behavioral_environment",
        "annotation_scheme"
      ]
    },
    "axiology_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "primary_url": {"type": "string", "format": "uri"},
    "status": {"enum": ["catalogued", "verified"]}
  },
  "additionalProperties": false
}

